# Public VPN endpoint (IP address or DNS name)
VPN_PUBLIC_IP=vpn.example.com
VPN_IPSEC_PSK=replace-with-a-random-32-character-secret
VPN_USER=admin
VPN_PASSWORD=replace-with-a-random-24-character-secret

# Dashboard security
WEBUI_PASSWORD=replace-with-a-random-24-character-secret
BACKUP_PASSPHRASE=replace-with-a-separate-random-32-character-secret
WEBUI_BIND_ADDRESS=127.0.0.1
WEBUI_PORT=8080
WEBUI_SECURE_COOKIE=false
# Enable only when exactly one trusted reverse proxy sits in front of the dashboard.
WEBUI_TRUST_PROXY=false
WEBUI_DOMAIN=panel.example.com
ACME_EMAIL=admin@example.com

# Privacy controls (both are opt-in)
DNS_LOGGING_ENABLED=false
DNS_LOG_RETENTION_DAYS=30
GEOIP_ENABLED=false

# Deployment
TZ=Etc/UTC
VPN_DNS_SRV1=172.20.0.3
VPN_DNS_SRV2=1.1.1.1
# Optional: set to yes if you want generated IKEv2 profiles password-protected.
VPN_PROTECT_CONFIG=no
# For strict reproducibility, set this to an architecture-specific image digest.
IPSEC_IMAGE=hwdsl2/ipsec-vpn-server@sha256:faddc89bd8bfb061fa95825995834d749d84f2ef229c1a657eeffc5c93303ac2
